# Server
PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string

# Bootstrap admin user — only used the very first time the app runs
# (i.e. when data/users.json has no users yet). Change the password after first login.
ADMIN_USER=admin
ADMIN_PASS=changeme

# Equiline submission — a plain POST of the XML to this URL, no login.
# Test server shown; swap in the live URL when Equiline gives it to you.
# Use a plain "&" here, not "&amp;".
EQUILINE_SUBMIT_URL=http://www.test.equineline.com/xml/CatalogAppServices.cfm?s=updates&t=xml
